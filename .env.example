# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Clave de la API de Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# User-Agent descriptivo exigido por MusicBrainz y Wikidata: "App/versión (contacto)"
MB_USER_AGENT=SonarMatch/0.1 (proyecto académico PTIA; https://github.com/<usuario>/sonarmatch)
# Ruta de la base SQLite usada por la app y la CLI
SONARMATCH_DB=data/sonarmatch.db
